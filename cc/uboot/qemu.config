# Board part of the P2 configuration for QEMU virt (emulated CC).
# Read a fixed-size raw FIT slot from the first virtio disk, boot it, and
# reset on any failure so that no console prompt is ever reached.
CONFIG_BOOTCOMMAND="virtio scan; virtio read 0x50000000 0 0x20000; bootm 0x50000000; reset"
CONFIG_BOOTARGS="console=ttyAMA0 rdinit=/init panic=-1"
