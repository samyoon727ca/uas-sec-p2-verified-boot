# P2 boot-loader hardening (docs/02-cc-boot-chain.md section 2.3, SR-005.1).
# Applied on top of the board defconfig, then checked line by line against
# the built .config by cc/build.sh.

# Signed FIT configurations only; no unsigned legacy uImages.
CONFIG_FIT_SIGNATURE=y
# CONFIG_LEGACY_IMAGE_FORMAT is not set

# Environment compiled into the verified image; nothing read from storage.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FLASH is not set

# Autoboot with no check for a keypress; no standard-boot disk scan.
CONFIG_BOOTDELAY=-2
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_USE_BOOTARGS=y
# CONFIG_USE_PREBOOT is not set

# Measured boot into the TPM (docs/03).
CONFIG_MEASURED_BOOT=y

# Room for the uncompressed arm64 kernel.
CONFIG_SYS_BOOTM_LEN=0x8000000

# Not part of a production boot loader.
# CONFIG_UNIT_TEST is not set
