# Control build only (TC-04h-control). The P2 configuration with one change:
# the boot command has no final "reset", so a refused boot falls through to
# the console. It shows that TC-04h would see a console if one were offered.
# Never used to boot a CC.
CONFIG_BOOTCOMMAND="virtio scan; virtio read 0x50000000 0 0x20000; bootm 0x50000000"
